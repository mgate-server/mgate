{
  "name": "mgate-web",
  "private": true,
  "version": "2026.10.4",
  "description": "MGate web workspace: admin panel, self-service account, webmail SPA",
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/spa",
    "build": "npm run build -w apps/spa",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "npm run test -w apps/spa",
    "test:watch": "npm run test:watch -w apps/spa",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen": "npm run gen -w @mgate/api-client"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.2",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}

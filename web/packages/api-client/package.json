{
  "name": "@mgate/api-client",
  "private": true,
  "version": "2026.10.2",
  "description": "Typed fetch client for the mgate API, generated from openapi.json. Consumed as TS source directly, no build step.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "gen": "openapi-typescript ./openapi.json -o ./src/generated/schema.d.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3"
  }
}

# =============================================================================
# MGate — пример файла окружения (.env)
# Скопируйте этот файл в `.env` и заполните значения, либо выполните
# `make init` / `scripts/gen-secrets.sh`, которые сгенерируют случайные
# секреты и НЕ перезапишут уже существующие значения в .env.
#
# Файл читается docker compose (переменные для docker-compose.yml) и
# передаётся внутрь контейнеров как переменные окружения MGATE_*, которыми
# backend (закрытый образ, docs/ARCHITECTURE.md) можно переопределить
# опциональный /etc/mgate/mgate.toml. Переменные вида `*_FILE` (docker
# secrets) поддерживаются загрузчиком конфигурации отдельно — см.
# docs/CONFIGURATION.md.
# =============================================================================

# --- Базовые параметры инсталляции ------------------------------------------
# FQDN почтового сервера: используется как цель MX, HELO/EHLO, имя хоста
# админ-панели и веб-почты, Subject CN самоподписанного сертификата.
MGATE_HOSTNAME=mail.example.com
# Email администратора: аккаунт ACME (Let's Encrypt/ZeroSSL) + логин первого
# суперадминистратора, создаваемого командой `mgate init`.
MGATE_ADMIN_EMAIL=admin@example.com
# Пароль первого суперадминистратора. Если пусто — `mgate init` сгенерирует
# случайный пароль и один раз выведет его в лог при первом запуске.
MGATE_ADMIN_PASSWORD=
# Часовой пояс контейнеров (используется cron/логами/бэкапом).
TZ=UTC

# --- Образы (реестр и версия) -------------------------------------------------
# Реестр контейнерных образов: все 10 образов продукта (mgate, mgate-agent, web, postfix,
# dovecot, rspamd, unbound, traefik, backup, firewall) публикуются анонимно в
# ghcr.io/mgate-server. Образ backend'а `mgate` закрытый (исходный код не распространяется).
MGATE_REGISTRY=ghcr.io/mgate-server
# Тег версии образов. Версия единая для всего продукта (все образы, Helm-чарт, backend) и
# имеет формат CalVer `ГГГГ.М.N`: год, месяц БЕЗ ведущего нуля, номер сборки внутри месяца
# (например, 2026.10.1). Доступные теги: `2026.10.1` (неизменяемый), `2026.10` (скользящий —
# последняя сборка месяца), `latest` (последний релиз). `latest` удобен для знакомства; в
# продакшене зафиксируйте точную версию (например, MGATE_VERSION=2026.10.1) и обновляйтесь
# осознанно, читая CHANGELOG.md.
MGATE_VERSION=2026.10.4
# Имя закрытого образа backend'а БЕЗ тега (api/webmail/worker/migrate — один образ, роль
# выбирается подкомандой); тег берётся отдельно из MGATE_VERSION (docker-compose.yml склеивает
# их как ${MGATE_IMAGE}:${MGATE_VERSION}). По умолчанию собирается из MGATE_REGISTRY; переопределите
# только если тестируете локально собранный образ backend'а.
# MGATE_IMAGE=${MGATE_REGISTRY}/mgate
# Полная ссылка на образ mgate-agent (бинарь, который copy'ят в себя postfix/dovecot/firewall
# при сборке из исходников — docker-compose.build.yml). По умолчанию тоже собирается из
# MGATE_REGISTRY/MGATE_VERSION; переопределите для локально собранного образа агента.
# MGATE_AGENT_IMAGE=${MGATE_REGISTRY}/mgate-agent:${MGATE_VERSION}

# --- Сеть и публикуемые порты -------------------------------------------------
# Интерфейс, на котором публикуются HTTP/HTTPS порты (Traefik) и почтовые
# порты (Postfix/Dovecot). 0.0.0.0 — слушать на всех интерфейсах.
MGATE_BIND_ADDRESS=0.0.0.0
MGATE_HTTP_PORT=80
MGATE_HTTPS_PORT=443
# Traefik следит за /etc/traefik/dynamic через inotify. Если на хосте исчерпан
# лимит fs.inotify.max_user_instances (много контейнеров), провайдер файлов не
# стартует и прокси остаётся без маршрутов — тогда поставьте false (файлы
# читаются один раз при старте; после записи 10-certs.yml нужен restart).
MGATE_TRAEFIK_FILE_WATCH=true
# Сколько секунд entrypoint Traefik ждёт появления bootstrap-сертификата
# почтовых контейнеров (/certs/default) перед тем как опубликовать
# 05-bootstrap-certs.yml без него (docs/CONFIGURATION.md).
MGATE_TRAEFIK_CERT_WAIT=20
# Порты почтовых протоколов на хосте (внутри контейнеров всегда стандартные).
# Менять стоит только при rootless Docker (не может занять порты <1024, пока
# не понижен net.ipv4.ip_unprivileged_port_start) или в тестовых стендах:
# для приёма почты из интернета MX-хост обязан слушать 25.
MGATE_SMTP_PORT=25
MGATE_SUBMISSIONS_PORT=465
MGATE_SUBMISSION_PORT=587
MGATE_IMAP_PORT=143
MGATE_IMAPS_PORT=993
MGATE_POP3_PORT=110
MGATE_POP3S_PORT=995
MGATE_MANAGESIEVE_PORT=4190

# --- SPA (сервис `web`, docker/web) -------------------------------------------
# Префикс, который SPA подставляет перед каждым вызовом /api/v1/... и /internal/v1/...
# (записывается в /config.json нгинксом при старте контейнера). Пусто — тот же origin, что и
# сама SPA: обычный случай, когда Traefik проксирует /api/* на тот же хост.
# Заполните, только если API живёт на другом хосте/порту, чем сама SPA.
MGATE_API_BASE_URL=
# Необязательные ссылки, которые админ-панель показывает в интерфейсе (попадают в /config.json как
# {"links":{"pricingUrl":...,"vendorPortalUrl":...}}). Ссылка показывается, только если
# соответствующая переменная задана; пусто — ссылки в интерфейсе не отображаются.
# Страница с тарифами и ценами Pro:
MGATE_PRICING_URL=
# Личный кабинет вендора (управление подпиской и лицензиями):
MGATE_VENDOR_PORTAL_URL=

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=mgate
POSTGRES_USER=mgate
# Пароль владельца БД (роль `mgate`: api/worker/webmail/migrate).
POSTGRES_PASSWORD=change-me-strong-password
# Технологическая роль только для чтения (Postfix/Dovecot SQL-запросы к
# view'ам v_postfix_*/v_dovecot_*). Создаётся docker/postgres/initdb/.
POSTGRES_MAIL_USER=mgate_mail
POSTGRES_MAIL_PASSWORD=change-me-strong-password

# --- Valkey (Redis-совместимый кэш/очереди/сессии) ---------------------------
VALKEY_PASSWORD=change-me-strong-password

# --- Строки подключения (собираются docker-compose.yml из переменных выше;
#     здесь приведены для справки, не обязательны к заполнению вручную) -------
# MGATE_DATABASE_URL=postgres://mgate:${POSTGRES_PASSWORD}@postgres:5432/mgate
# MGATE_REDIS_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0

# --- Секреты приложения -------------------------------------------------------
# Base64 от 32 случайных байт: используется для шифрования данных в состоянии
# покоя (приватный ключ инстанса, DKIM-ключи, TOTP-секреты) — XChaCha20-Poly1305.
MGATE_SECRET_KEY=change-me-base64-32-bytes
# Bearer-токен для внутреннего API (/internal/v1/*) между api/worker/webmail и
# postfix/dovecot/mgate-agent.
MGATE_INTERNAL_TOKEN=change-me-strong-token
# Ключ доступа к doveadm HTTP API (Dovecot).
DOVEADM_API_KEY=change-me-strong-token
# Пароль контроллера Rspamd (веб-UI/API на порту 11334).
RSPAMD_CONTROLLER_PASSWORD=change-me-strong-password

# --- ACME (Let's Encrypt / ZeroSSL) ------------------------------------------
MGATE_ACME_ENABLED=true
# letsencrypt | letsencrypt-staging | zerossl | произвольный URL ACME-директории
MGATE_ACME_DIRECTORY=letsencrypt
# http-01 | dns-01
MGATE_ACME_CHALLENGE=http-01
# Провайдер DNS API для dns-01 (cloudflare | route53 | rfc2136 | ...); пусто
# для http-01.
MGATE_ACME_DNS_PROVIDER=
# External Account Binding для ZeroSSL (не нужно для Let's Encrypt).
MGATE_ACME_EAB_KID=
MGATE_ACME_EAB_HMAC=

# --- Исходящий HTTP(S)-прокси (api/webmail/worker/migrate и backup) ----------
# Нужен, только если у сервера нет прямого выхода в интернет: через прокси идут обращения к
# серверу лицензий, ACME-центру (Let's Encrypt/ZeroSSL) и удалённому репозиторию restic (S3).
# Пусто — прямые соединения. Пример: HTTPS_PROXY=http://proxy.example.com:3128
HTTPS_PROXY=
# Прокси для обычных http://-адресов (обычно не нужен).
HTTP_PROXY=
# Дополнительные исключения через запятую (домены, IP, подсети), которые нужно открывать
# напрямую, мимо прокси. Внутренние имена сервисов стека (api, postgres, valkey, dovecot,
# rspamd и т.д.), localhost и 127.0.0.1 docker-compose.yml добавляет сам — их указывать не нужно.
NO_PROXY=

# --- Прочие параметры почтового ядра -----------------------------------------
# Максимальный размер сообщения в байтах (по умолчанию 50 МиБ).
MGATE_MESSAGE_SIZE_LIMIT=52428800
# Ключ Spamhaus Data Query Service (DQS, https://www.spamhaus.com/dqs/).
# При заполнении Postfix postscreen запрашивает DNSBL-зоны через выделенный DQS-ключ,
# а postscreen_dnsbl_reply_map скрывает ключ в ответах 550 reject.
# Пусто — используются бесплатные публичные зоны zen.spamhaus.org и др.
MGATE_SPAMHAUS_DQS_KEY=

# --- Логирование ---------------------------------------------------------------
# trace | debug | info | warn | error
MGATE_LOG_LEVEL=info
# json | pretty
MGATE_LOG_FORMAT=json

# --- Docker Compose профили ---------------------------------------------------
# Список профилей, включённых по умолчанию (через запятую, без пробелов).
# `clamav`  — включает антивирус ClamAV (можно убрать для экономии RAM).
# `backup`  — включает контейнер резервного копирования (restic + pg_dump, docs/BACKUP.md).
# `firewall`— включает контейнер nftables + mgate-agent --role firewall.
# (Профиль `restore` сюда не добавляйте: его разово запускает `make restore`.)
# Пример: COMPOSE_PROFILES=clamav,backup
COMPOSE_PROFILES=clamav

# --- Внутренняя сеть Docker ---------------------------------------------------
# Подсеть внутренней (internal) сети `backend`.
MGATE_BACKEND_SUBNET=172.30.1.0/24
# Статический IP резолвера unbound внутри сети `backend` — используется как
# `dns:` для контейнеров, которым нужна DNSSEC-валидация исходящих запросов.
MGATE_RESOLVER_IP=172.30.1.53
# Статический IP Valkey внутри сети `backend` — нужен только контейнеру
# `firewall` (network_mode: host, без DNS docker compose), чтобы достучаться
# до pubsub-канала mgate:bans:events напрямую по IP. Остальные сервисы
# обращаются к Valkey по имени `valkey` через MGATE_REDIS_URL.
MGATE_VALKEY_IP=172.30.1.10

# --- Резервное копирование (профиль backup) ----------------------------------
# Каталог на хосте, монтируемый в контейнер backup как /backups (bind mount). Если его нет,
# docker создаст его сам (владелец root) — так и нужно. Каталог, созданный заранее другим
# пользователем, отдайте root: `sudo chown 0:0 ./backups` (иначе бэкап не стартует).
MGATE_BACKUP_DIR=./backups
# Расписание в формате cron (supercronic), по умолчанию — каждую ночь в 03:00.
BACKUP_SCHEDULE="0 3 * * *"
# Репозиторий restic: локальный путь внутри /backups (по умолчанию) либо
# удалённое хранилище, например s3:https://s3.example.com/mgate-backups
RESTIC_REPOSITORY=/backups/restic
# Пароль шифрования репозитория restic (ОБЯЗАТЕЛЬНО сохраните отдельно —
# без него восстановление невозможно).
RESTIC_PASSWORD=change-me-strong-password
# Учётные данные для S3-совместимого хранилища (если RESTIC_REPOSITORY
# указывает на s3:...). Оставьте пустыми для локального хранения.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Политика хранения снапшотов restic (retention policy).
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6

# =============================================================================
# Переменные окружения только для docker-compose.dev.yml (режим разработки).
# Не используются в продакшн-развёртывании (docker-compose.yml) — сам
# docker-compose.dev.yml жёстко задаёт MGATE_RELAYHOST=[mailpit]:1025 для
# сервиса postfix, здесь строка оставлена закомментированной для справки.
# =============================================================================
# Postfix relayhost в dev-режиме: вся исходящая почта перенаправляется в
# mailpit (контейнер-перехватчик почты для разработки), а не в реальный
# интернет. Имя переменной согласовано с образом docker/postfix (mail-агент):
# entrypoint должен подставлять её в `relayhost` при непустом значении.
# MGATE_RELAYHOST=[mailpit]:1025
#
# Порты на 127.0.0.1, которые публикует docker-compose.dev.yml (переопределите,
# если стандартные заняты на машине разработчика, например 8025 другим mailpit):
# MGATE_DEV_API_PORT=8080
# MGATE_DEV_WEBMAIL_PORT=8082
# MGATE_DEV_MAILPIT_PORT=8025
# MGATE_DEV_POSTGRES_PORT=5432
# MGATE_DEV_VALKEY_PORT=6379
# MGATE_DEV_RSPAMD_PORT=11334
